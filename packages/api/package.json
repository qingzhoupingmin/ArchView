{
  "name": "@archview/api",
  "version": "0.0.1",
  "private": true,
  "description": "ArchView 后端服务（NestJS + Prisma + SQLite，REST API 前缀 /api/v1）",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "predev": "pnpm --filter @archview/core build",
    "build": "tsc -p tsconfig.build.json && node scripts/write-version.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "pnpm --filter @archview/core build",
    "pretypecheck": "pnpm --filter @archview/core build",
    "db:setup": "node scripts/db-setup.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@archview/core": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
