# 数据库（SQLite 文件存储；相对路径基于 packages/api/prisma/ 解析，数据落在仓库根 ./data/）
DATABASE_URL=file:../../data/archview.db
# JWT 签名密钥（access 2h + refresh 7d）
# ⚠️ 这一行是**本地开发专用**的占位值：整套账号隔离都建立在这枚密钥之上，
#    用它签名等于任何人都能伪造 sub=任意用户 的令牌去读别人的工程。
#    部署到任何可被他人访问的实例前，必须换成 ≥32 字符的随机串，并设置 NODE_ENV=production
#    （生产模式下密钥缺失/仍是占位值会让 API 直接拒绝启动，见 packages/api/src/config/env.ts）。
#    生成一条：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-jwt-secret
# 运行环境：本地开发留空或 development；服务器部署务必改为 production
# NODE_ENV=production
# 种子超管密码（pnpm db:setup 使用；不设则默认 admin123）
# SEED_ADMIN_PASSWORD=admin123
# CORS 允许的来源（多个用英文逗号分隔）：
# 仅「页面 origin ≠ API origin」时才需要登记（典型：IIS :80 托管静态页 + 前端跨端口调 :3007）。
# https 同域反代入口（Tailscale Serve / Funnel 的 :443 → 3007）与 :3007 直连入口都是同源，
# 浏览器不发 CORS 请求，无需登记；本地开发用局域网 IP 访问时需追加该来源，
# 例：http://192.168.1.10:5173,http://your-domain.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# 后端端口
PORT=3007
# 前端构建目录（API 同端口托管 web 构建；monorepo 开发模式默认 apps/web/dist，无需设置；服务器示例如下）
# WEB_ROOT=D:/Server/www/archview
# ---- 以下为前端（apps/web）构建期变量，仅供备忘 ----
# Vite 的 envDir 是 apps/web，根目录 .env 不会注入前端构建：要覆盖请写 apps/web/.env 或构建期用环境变量传入。
# 默认无需设置：前端按页面 origin 自动判定同源（https 反代入口 / :3007 直连 → 相对 /api/v1；IIS :80 → 同机 :3007）
# VITE_API_BASE=http://10.0.0.5:3007/api/v1
