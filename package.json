{
  "name": "archview",
  "version": "0.0.1",
  "private": true,
  "description": "ArchView —— 面向数据机房的开源 Web 三维建模与数字孪生可视化工具（粉白风格）",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"pnpm --filter @archview/web dev\" \"pnpm --filter @archview/api dev\"",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run && pnpm --filter @archview/api test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:components": "vitest run packages/component-lib",
    "brand:favicon": "node scripts/brand/gen-favicon.mjs",
    "fps": "pnpm --filter @archview/web dev",
    "db:setup": "pnpm --filter @archview/api db:setup",
    "start:all": "concurrently -k -n api,web -c green,cyan \"pnpm --filter @archview/api start\" \"pnpm --filter @archview/web preview\"",
    "deploy:server": "node scripts/deploy/server.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
